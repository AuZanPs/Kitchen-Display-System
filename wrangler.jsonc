{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kds",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-13",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "VENUE_ROOM", "class_name": "VenueRoom" },
      { "name": "DIRECTORY", "class_name": "Directory" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["VenueRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] }
  ],
  "vars": {
    "BASE_HOST": "layardapur.web.id",
    "EMAIL_FROM": "masuk@layardapur.web.id"
  },
  "send_email": [{ "name": "EMAIL" }],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
